---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import { getCollection } from 'astro:content';
import { colorForCategory } from '../../lib/categoryColors';
import { readData } from '../../lib/readData';
import {
  normalizeCategories,
  categoryMatches,
  collectOrphanCategories,
  type CategoryEntry,
} from '../../lib/categorySlug';

export async function getStaticPaths() {
  const rawCats = readData('categories.json', []);
  const registered = normalizeCategories(rawCats);
  const allPosts = await getCollection('blog');
  const postCats = [...new Set(allPosts.map((p: any) => p.data.category).filter(Boolean))];
  const orphans = collectOrphanCategories(postCats, registered);
  const all: CategoryEntry[] = [...registered, ...orphans];
  return all.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CategoryEntry };
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p: any) => categoryMatches(p.data.category, entry))
  .sort((a: any, b: any) => {
    const da = new Date(a.data.pubDate || a.data.date || 0).getTime();
    const db = new Date(b.data.pubDate || b.data.date || 0).getTime();
    return db - da;
  });

const catColor = colorForCategory(entry.name);
---

<BaseLayout title={entry.name} description={entry.description || `Artigos sobre ${entry.name}`}>
  <section class="border-b border-rule">
    <div class="container-x pt-16 md:pt-20 pb-10 md:pb-12 max-w-3xl">
      <nav class="mb-5 text-sm" aria-label="Breadcrumb">
        <a href="/blog" class="text-ink-faint hover:text-primary transition-colors">Blog</a>
        <span class="mx-2 text-ink-faint">/</span>
        <span class={`badge-cat badge-cat-${catColor}`}>{entry.name}</span>
      </nav>
      <h1 class="font-display text-3xl md:text-5xl font-extrabold tracking-tight text-ink leading-[1.05] mb-4">
        {entry.name}
      </h1>
      {entry.description && (
        <p class="text-lg text-ink-muted leading-relaxed mb-2">{entry.description}</p>
      )}
      <p class="mono uppercase text-ink-faint">
        {posts.length} {posts.length === 1 ? 'artigo' : 'artigos'}
      </p>
    </div>
  </section>

  <div class="container-x py-12 md:py-16">
    {posts.length === 0 ? (
      <div class="py-20">
        <p class="mono uppercase text-ink-faint mb-3">vazio</p>
        <p class="text-ink-muted">Nenhum artigo nesta categoria ainda.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post: any, i: number) => (
          <PostCard post={post} index={i} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
