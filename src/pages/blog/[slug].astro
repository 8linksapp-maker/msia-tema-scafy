---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import EmailInlineBanner from '../../plugins/email-list/EmailInlineBanner.astro';
import AffiliateProducts from '../../plugins/affiliates/AffiliateProducts.astro';
import PostSchemaPlugins from '../../plugins/_slots/PostSchemaPlugins.astro';
import PostBottomPlugins from '../../plugins/_slots/PostBottomPlugins.astro';
import PostAfterPlugins from '../../plugins/_slots/PostAfterPlugins.astro';
import SocialShare from '../../plugins/social-share/SocialShare.astro';
import PostVideo from '../../components/ui/PostVideo.astro';
import { getCollection } from 'astro:content';
import { readData } from '../../lib/readData';
import { normalizeCategories, getCategorySlug } from '../../lib/categorySlug';
import { colorForCategory } from '../../lib/categoryColors';
import { parseVideoUrl } from '../../lib/videoEmbed';
import { renderShortcodes, hasShortcodes } from '../../lib/shortcodes';
const authorsData = readData('authors.json', []);
const allCategories = normalizeCategories(readData('categories.json', []));

const pluginsConfig = readData('pluginsConfig.json', {}) as any;
const inlineConfig = pluginsConfig?.emailList?.inline;
const inlineEnabled = inlineConfig?.enabled === true;
const inlinePosition = Number(inlineConfig?.position ?? 3);

export async function getStaticPaths() {
  const siteConfig = readData('siteConfig.json', {}) as any;
  // Se aluno escolheu URL limpa (sem /blog), nao geramos /blog/X
  if (siteConfig.postUrlPrefix !== 'blog') return [];
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
const post = Astro.props;
const { Content } = await post.render();
const data = post.data;

const currentAuthor = authorsData.find((a: any) => a.id === data.author) || authorsData[0] || {
  name: 'Equipe',
  role: 'Redação',
  avatar: '',
  bio: ''
};

const categorySlug = data.category ? getCategorySlug(data.category, allCategories) : '';
const catColor = colorForCategory(data.category);
const siteConfig = readData('siteConfig.json', {}) as any;
const postUrl = `${siteConfig.url || Astro.url.origin}/blog/${post.slug}`;

function fmtDate(d: any): string {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return '';
  return dt.toLocaleDateString('pt-BR', { year: 'numeric', month: 'long', day: '2-digit' });
}

const readingMinutes = (() => {
  try {
    const text = (post.body || '') as string;
    const words = text.split(/\s+/).length;
    return Math.max(1, Math.round(words / 200));
  } catch { return 5; }
})();

// Próximos posts
const allPosts = await getCollection('blog');
const related = allPosts
  .filter((p: any) => (p.slug ?? p.id) !== (post.slug ?? post.id))
  .slice(0, 3);

const videoUrl = data.videoUrl || '';
const videoInfo = videoUrl ? parseVideoUrl(videoUrl) : null;
const hasValidVideo = videoInfo && videoInfo.provider !== 'unknown';
const videoPosition = data.videoPosition || 'after-hero';

const rawBody = (post.body || '') as string;
const isHtmlBody = /^\s*</.test(rawBody.trim());
const processedHtml = isHtmlBody && hasShortcodes(rawBody) ? renderShortcodes(rawBody) : null;
---

<BaseLayout title={data.title} description={data.description} image={data.heroImage} type="article">
  <PostSchemaPlugins
    title={data.title}
    description={data.description || ''}
    url={postUrl}
    image={data.heroImage}
    datePublished={data.pubDate instanceof Date ? data.pubDate.toISOString() : data.pubDate}
    authorName={currentAuthor?.name}
    category={data.category}
    videoUrl={hasValidVideo ? videoUrl : undefined}
  />

  <article>
    <!-- HEADER corporativo (Inter, azul, badge — sem color-block) -->
    <header class="border-b border-rule">
      <div class="container-x pt-14 md:pt-20 pb-10 md:pb-12 max-w-3xl">
        <nav class="mb-6 text-sm flex items-center gap-2 flex-wrap" aria-label="Breadcrumb">
          <a href="/" class="text-ink-faint hover:text-primary transition-colors">Início</a>
          <span class="text-ink-faint">/</span>
          <a href="/blog" class="text-ink-faint hover:text-primary transition-colors">Blog</a>
          {data.category && (
            <>
              <span class="text-ink-faint">/</span>
              <a href={`/categoria/${categorySlug}`}><span class={`badge-cat badge-cat-${catColor}`}>{data.category}</span></a>
            </>
          )}
        </nav>

        <h1 class="font-display text-3xl md:text-5xl font-extrabold leading-[1.05] tracking-tight text-ink mb-5">
          {data.title}
        </h1>

        {data.description && (
          <p class="text-lg md:text-xl text-ink-muted leading-relaxed mb-6">{data.description}</p>
        )}

        <div class="mono uppercase text-ink-faint flex items-center gap-3 flex-wrap">
          <span>{fmtDate(data.pubDate)}</span>
          <span class="opacity-50">·</span>
          <span>{readingMinutes} min de leitura</span>
          {currentAuthor?.name && (<><span class="opacity-50">·</span><span>por {currentAuthor.name}</span></>)}
        </div>
      </div>
    </header>

    <!-- HERO MEDIA: vídeo ou imagem -->
    {hasValidVideo && videoPosition === 'hero' ? (
      <div class="border-b border-rule">
        <div class="container-x py-8">
          <PostVideo
            url={videoUrl}
            title={data.title}
            description={data.description}
            uploadDate={data.pubDate instanceof Date ? data.pubDate.toISOString() : String(data.pubDate)}
            lite={true}
          />
        </div>
      </div>
    ) : data.heroImage ? (
      <div class="border-b border-rule">
        <div class="container-x py-8">
          <img
            src={data.heroImage}
            alt={data.title}
            class="w-full aspect-[21/9] object-cover rounded"
            loading="eager"
          />
        </div>
      </div>
    ) : null}

    {hasValidVideo && videoPosition === 'after-hero' && (
      <div class="border-b border-rule">
        <div class="container-x py-8">
          <PostVideo
            url={videoUrl}
            title={data.title}
            description={data.description}
            uploadDate={data.pubDate instanceof Date ? data.pubDate.toISOString() : String(data.pubDate)}
            lite={true}
          />
        </div>
      </div>
    )}

    <!-- CONTEÚDO -->
    <div class="container-x py-12 md:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        <div class="lg:col-span-8 lg:col-start-3">
          <div class="post-content prose-msia max-w-none">
            {processedHtml ? (
              <Fragment set:html={processedHtml} />
            ) : (
              <Content />
            )}
          </div>

          {inlineEnabled && (
            <div id="email-inline-source" data-position={inlinePosition} style="display:none">
              <EmailInlineBanner />
            </div>
          )}

          <AffiliateProducts />

          <!-- rodapé do post: categoria + plugins -->
          <div class="mt-10 pt-6 border-t border-rule flex items-center justify-between gap-4 flex-wrap">
            {data.category && (
              <a href={`/categoria/${categorySlug}`}><span class={`badge-cat badge-cat-${catColor}`}>{data.category}</span></a>
            )}
            <PostBottomPlugins title={data.title} />
          </div>

          <!-- sobre o autor -->
          <div class="mt-10 card-trade p-6 flex items-start gap-4">
            {currentAuthor.avatar ? (
              <img src={currentAuthor.avatar} alt={currentAuthor.name} class="w-16 h-16 rounded-full object-cover shrink-0" />
            ) : (
              <div class="w-16 h-16 rounded-full bg-primary-soft text-primary flex items-center justify-center text-2xl font-bold shrink-0">
                {currentAuthor.name.charAt(0)}
              </div>
            )}
            <div>
              <h4 class="font-display text-lg font-bold text-ink">{currentAuthor.name}</h4>
              {currentAuthor.role && <p class="text-sm font-semibold text-primary mb-1">{currentAuthor.role}</p>}
              {currentAuthor.bio && <p class="text-sm text-ink-muted leading-relaxed">{currentAuthor.bio}</p>}
              <div class="mt-2"><SocialShare title={data.title} context="author-box" /></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <PostAfterPlugins
      currentSlug={post.slug}
      category={data.category || ''}
    />

    <!-- RELACIONADOS (cards corporativos) -->
    {related.length > 0 && (
      <section class="border-t border-rule">
        <div class="container-x py-12 md:py-16">
          <p class="eyebrow mb-6">continuar lendo</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((p: any, i: number) => (
              <PostCard post={p} index={i} />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  <script is:inline>
  // Substitui &nbsp; (espaço não-quebrável do Quill) por espaços normais nos artigos já salvos
  (function() {
    var postContent = document.querySelector('.post-content');
    if (!postContent) return;
    var walker = document.createTreeWalker(postContent, NodeFilter.SHOW_TEXT, null);
    var node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue && node.nodeValue.indexOf(' ') !== -1) {
        node.nodeValue = node.nodeValue.replace(/ /g, ' ');
      }
    }
  })();
  </script>

  {inlineEnabled && (
    <script>
    (function() {
      const source = document.getElementById('email-inline-source');
      if (!source) return;
      const pos = Number((source as HTMLElement).dataset.position) || 3;
      const paragraphs = document.querySelectorAll('.post-content > p');
      const target = paragraphs[pos - 1] || paragraphs[paragraphs.length - 1];
      if (target) {
        target.insertAdjacentElement('afterend', source);
        source.style.display = 'block';
      }
    })();
    </script>
  )}
</BaseLayout>
