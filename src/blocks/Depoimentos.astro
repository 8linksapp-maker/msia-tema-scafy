---
/**
 * Bloco depoimentos — citações de clientes em cards (fundo gelo).
 */
interface Item { quote: string; name: string; role?: string; }
interface Props { eyebrow?: string; title: string; rating?: { score: string; label: string }; items?: Item[]; }
const { eyebrow, title, rating, items = [] } = Astro.props;
---
<section class="bg-surface border-b border-rule">
  <div class="container-x py-14 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-10 md:mb-12">
      <div class="max-w-2xl">
        {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
        <h2 class="font-display text-2xl md:text-4xl font-bold tracking-tight text-ink leading-[1.1]">{title}</h2>
      </div>
      {rating && (
        <div class="text-right">
          <p class="font-display text-3xl font-extrabold text-primary">★ {rating.score}</p>
          <p class="text-sm text-ink-muted">{rating.label}</p>
        </div>
      )}
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {items.map((t) => (
        <figure class="card-trade p-7 bg-bg">
          <blockquote class="text-ink leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="mt-5">
            <p class="font-semibold text-ink">{t.name}</p>
            {t.role && <p class="text-sm text-ink-muted">{t.role}</p>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
