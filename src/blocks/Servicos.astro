---
/**
 * Bloco servicos — grade de cards (card-trade) com título/texto e link opcional.
 * Genérico: o conteúdo vem das props (não lê servicos.json — pra páginas livres).
 */
interface ServiceItem { title: string; text?: string; href?: string; imagem?: string; }
interface Props { eyebrow?: string; title: string; items?: ServiceItem[]; ctaLabel?: string; ctaHref?: string; }
const { eyebrow, title, items = [], ctaLabel, ctaHref } = Astro.props;
---
<section class="border-b border-rule">
  <div class="container-x py-14 md:py-20">
    <div class="max-w-2xl mb-10 md:mb-12">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h2 class="font-display text-2xl md:text-4xl font-bold tracking-tight text-ink leading-[1.1]">{title}</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((s) => {
        const Tag: any = s.href ? 'a' : 'article';
        return (
          <Tag href={s.href} class="card-trade group flex flex-col overflow-hidden">
            {s.imagem && (
              <img src={s.imagem} alt={s.title} loading="lazy" decoding="async" class="w-full aspect-[16/10] object-cover" />
            )}
            <div class="p-6 md:p-7 flex flex-col gap-3 flex-1">
              <h3 class="font-display text-lg md:text-xl font-bold tracking-tight text-ink leading-tight group-hover:text-primary transition-colors">{s.title}</h3>
              {s.text && <p class="text-sm text-ink-muted leading-relaxed line-clamp-3">{s.text}</p>}
              {s.href && (
                <span class="text-sm font-semibold text-primary mt-auto pt-2 inline-flex items-center gap-2 group-hover:gap-3 transition-all">
                  Ver detalhes
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </span>
              )}
            </div>
          </Tag>
        );
      })}
    </div>
    {ctaLabel && ctaHref && <div class="mt-10"><a href={ctaHref} class="btn btn-primary">{ctaLabel}</a></div>}
  </div>
</section>
