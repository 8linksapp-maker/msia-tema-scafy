---
/**
 * Bloco comoFunciona — passos numerados em cards (fundo gelo).
 */
interface Step { n: string; title: string; text?: string; }
interface Props { eyebrow?: string; title: string; steps?: Step[]; }
const { eyebrow, title, steps = [] } = Astro.props;
---
<section class="bg-surface border-b border-rule">
  <div class="container-x py-14 md:py-20">
    <div class="max-w-2xl mb-10 md:mb-12">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h2 class="font-display text-2xl md:text-4xl font-bold tracking-tight text-ink leading-[1.1]">{title}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <div class="card-trade p-7 bg-bg">
          <span class="font-display text-3xl font-extrabold text-primary">{s.n}</span>
          <h3 class="font-display text-lg font-bold text-ink mt-3">{s.title}</h3>
          {s.text && <p class="mt-2 text-sm text-ink-muted leading-relaxed">{s.text}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
