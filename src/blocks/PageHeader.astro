---
/**
 * Bloco pageHeader — cabeçalho de página (eyebrow + h1 + lead + trilha).
 * Look corporativo andaimes: fundo gelo, divisor inferior.
 */
interface Crumb { label: string; href: string; }
interface Props { eyebrow?: string; title: string; lead?: string; breadcrumb?: Crumb[]; }
const { eyebrow, title, lead, breadcrumb = [] } = Astro.props;
---
<section class="bg-surface border-b border-rule">
  <div class="container-x py-12 md:py-16">
    {breadcrumb.length > 0 && (
      <nav aria-label="Trilha" class="mb-5">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-ink-muted">
          {breadcrumb.map((c, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true" class="text-ink-faint">/</span>}
              {i < breadcrumb.length - 1
                ? <a href={c.href} class="hover:text-primary transition-colors">{c.label}</a>
                : <span class="text-ink" aria-current="page">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="font-display text-3xl md:text-5xl font-extrabold tracking-tight text-ink leading-[1.05]">{title}</h1>
    {lead && <p class="text-lg md:text-xl text-ink-muted leading-relaxed mt-6 max-w-2xl">{lead}</p>}
  </div>
</section>
