---
/**
 * Bloco porqueEscolher — diferenciais em 2 colunas de cards com imagem central.
 */
interface Feature { title: string; text?: string; }
interface Props { eyebrow?: string; title: string; imagem?: string; features?: Feature[]; }
const { eyebrow, title, imagem, features = [] } = Astro.props;
const left = features.slice(0, 3);
const right = features.slice(3, 6);
---
<section class="border-b border-rule">
  <div class="container-x py-14 md:py-20">
    <div class="max-w-2xl mb-10 md:mb-12">
      {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
      <h2 class="font-display text-2xl md:text-4xl font-bold tracking-tight text-ink leading-[1.1]">{title}</h2>
    </div>
    <div class="grid gap-6 lg:grid-cols-3 items-stretch">
      <div class="grid gap-6 content-center">
        {left.map((f) => (
          <div class="card-trade p-5">
            <h3 class="font-display text-base font-bold text-ink">{f.title}</h3>
            {f.text && <p class="mt-1 text-sm text-ink-muted leading-relaxed">{f.text}</p>}
          </div>
        ))}
      </div>
      <div class="overflow-hidden border border-border rounded bg-surface min-h-[16rem]">
        {imagem && <img src={imagem} alt={title} loading="lazy" decoding="async" class="w-full h-full object-cover" />}
      </div>
      <div class="grid gap-6 content-center">
        {right.map((f) => (
          <div class="card-trade p-5">
            <h3 class="font-display text-base font-bold text-ink">{f.title}</h3>
            {f.text && <p class="mt-1 text-sm text-ink-muted leading-relaxed">{f.text}</p>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
