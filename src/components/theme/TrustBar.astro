---
/**
 * TrustBar.astro — barra de confiança sob o hero (padrão "corporativo confiável"
 * da skill seo-local). Selos genéricos do nicho de andaimes — sem dado sensível
 * inventado. Editável via home.json (home.trustBar) quando o aluno preencher.
 */
import { readData } from '../../lib/readData';

const home = readData('home.json', {}) as any;

// Selos default genéricos do nicho (o aluno edita em /admin via home.trustBar)
const defaults = [
  { label: 'Montagem conforme a NR-18', icon: 'shield' },
  { label: 'ART do responsável técnico', icon: 'badge' },
  { label: 'Anos de experiência no setor', icon: 'star' },
  { label: 'Entrega no canteiro', icon: 'truck' },
  { label: 'Atendimento direto no WhatsApp', icon: 'chat' },
];

const items: { label: string; icon?: string }[] =
  Array.isArray(home?.trustBar) && home.trustBar.length ? home.trustBar : defaults;
---
<section class="trust-bar border-b border-rule">
  <div class="container-x py-4 md:py-5">
    <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3 md:gap-x-10">
      {items.map((it) => (
        <li class="trust-item flex items-center gap-2 text-sm font-medium">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
            {it.icon === 'badge' && (<><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5 17 22l-5-3-5 3 1.5-8.5"/></>)}
            {it.icon === 'star' && (<polygon points="12 2 15 9 22 9.3 16.5 14 18.5 21 12 17 5.5 21 7.5 14 2 9.3 9 9"/>)}
            {it.icon === 'truck' && (<><path d="M1 3h13v13H1z"/><path d="M14 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></>)}
            {it.icon === 'chat' && (<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z"/>)}
            {(!it.icon || it.icon === 'shield') && (<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>)}
          </svg>
          <span>{it.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
