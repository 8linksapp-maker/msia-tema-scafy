---
import { colorForCategory } from '../../lib/categoryColors';
import { postUrl } from '../../lib/postUrl';

interface Props {
  post: any;
  index?: number;
}

const { post, index = 0 } = Astro.props;

const data = post.data ?? post;
const slug = post.slug ?? post.id;
const url = postUrl(slug);
const title = data.title || 'Sem título';
const excerpt = data.description || data.excerpt || '';
const category = data.category || 'Geral';
const date = data.pubDate || data.date || data.publishedAt;
const thumb = data.heroImage || data.cover || data.coverImage;

const catColor = colorForCategory(category, index);

function fmtDate(d: any): string {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return '';
  return dt.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: '2-digit' });
}
---

<a href={url} class="card-trade group flex flex-col overflow-hidden">
  {thumb && (
    <img
      src={thumb}
      alt=""
      loading="lazy"
      decoding="async"
      class="w-full aspect-[16/9] object-cover"
    />
  )}
  <div class="p-6 flex flex-col gap-3 flex-1">
    <div class="flex items-center gap-3 flex-wrap">
      {category && <span class={`badge-cat badge-cat-${catColor}`}>{category}</span>}
      <span class="mono uppercase text-ink-faint">{fmtDate(date)}</span>
    </div>
    <h2 class="font-display text-xl font-bold tracking-tight text-ink leading-tight group-hover:text-primary transition-colors">
      {title}
    </h2>
    {excerpt && (
      <p class="text-sm text-ink-muted leading-relaxed line-clamp-3">{excerpt}</p>
    )}
    <span class="text-sm font-semibold text-primary mt-auto pt-2 inline-flex items-center gap-2 group-hover:gap-3 transition-all">
      Ler artigo
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </span>
  </div>
</a>
